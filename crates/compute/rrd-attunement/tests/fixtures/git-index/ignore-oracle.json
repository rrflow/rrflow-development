{
  "purpose": "Observed git check-ignore decisions on authored parser cases; not learning records.",
  "sources": [
    {
      "kind": "global",
      "patterns": "*.tmp\n*.log\n"
    },
    {
      "kind": "repository",
      "patterns": "!*.log\n"
    },
