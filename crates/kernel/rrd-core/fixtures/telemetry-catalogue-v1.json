{
  "catalogue": {
    "contract_version": 1,
    "default_diagnostic_level": "normal",
    "default_metric_cardinality_limit": 2000,
    "diagnostic_levels": [
      "off",
      "normal",
      "detailed",
      "profile"
    ],
    "metric_attributes": [
      "rrflow.boundary",
      "rrflow.operation",
      "rrflow.outcome",
      "rrflow.storage.profile",
      "rrflow.access.path",
      "rrflow.work.kind",
      "rrflow.queue.kind",
      "rrflow.cache.kind",
      "error.type"
    ],
    "metric_instruments": [
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "error.type"
        ],
        "description": "Wall duration of one exact operation boundary, recorded once with terminal outcome.",
        "instrument": "rrflow.operation.duration",
        "kind": "histogram",
        "unit": "s"
      },
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "error.type"
        ],
        "description": "Accepted terminal operations; denials, cancellations, and errors remain distinct outcomes.",
        "instrument": "rrflow.operation.count",
        "kind": "counter",
        "unit": "{operation}"
      },
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.operation",
          "rrflow.storage.profile",
          "rrflow.access.path"
        ],
        "description": "Currently admitted operations, including queued time until terminal release.",
        "instrument": "rrflow.operation.inflight",
        "kind": "up_down_counter",
        "unit": "{operation}"
      },
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.queue.kind"
        ],
        "description": "Bounded executor, maintenance, delivery, model, spill, and telemetry queue occupancy.",
        "instrument": "rrflow.queue.depth",
        "kind": "observable_gauge",
        "unit": "{item}"
      },
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.queue.kind",
          "error.type"
        ],
        "description": "Admission-to-execution delay separate from compute time.",
        "instrument": "rrflow.queue.wait",
        "kind": "histogram",
        "unit": "s"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "error.type"
        ],
        "description": "Physical KV keys examined by attributable point, range, and page operations.",
        "instrument": "rrflow.kv.keys.examined",
        "kind": "counter",
        "unit": "{item}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "error.type"
        ],
        "description": "Physical KV pages examined by attributable point, range, and page operations.",
        "instrument": "rrflow.kv.pages.examined",
        "kind": "counter",
        "unit": "{item}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Read, mapped, decoded, decompressed, borrowed, copied, allocated, WAL, flush, compaction, and spill byte work.",
        "instrument": "rrflow.kv.bytes",
        "kind": "counter",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.storage.profile",
          "rrflow.access.path",
          "rrflow.cache.kind",
          "error.type"
        ],
        "description": "Hit, miss, admission rejection, and eviction outcomes for a bounded cache class.",
        "instrument": "rrflow.kv.cache.requests",
        "kind": "counter",
        "unit": "{request}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.access.path",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Rows examined and emitted by rrflowQL, native, and DataFusion execution.",
        "instrument": "rrflow.query.rows",
        "kind": "counter",
        "unit": "{row}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.access.path",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Eligible graph edges and vertices traversed by query execution.",
        "instrument": "rrflow.query.graph.steps",
        "kind": "counter",
        "unit": "{step}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.access.path",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Lexical, vector, fusion, and exact-rerank candidate work by bounded access path.",
        "instrument": "rrflow.query.candidates",
        "kind": "counter",
        "unit": "{candidate}"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.work.kind"
        ],
        "description": "Current DataFusion pool reservation by bounded pool class.",
        "instrument": "rrflow.datafusion.memory.usage",
        "kind": "observable_gauge",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Peak DataFusion pool reservation observed for one terminal query execution.",
        "instrument": "rrflow.datafusion.memory.peak",
        "kind": "histogram",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "DataFusion spill bytes read and written by bounded work kind.",
        "instrument": "rrflow.datafusion.spill",
        "kind": "counter",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Authorized context input, output, selected, skipped, truncated, and compacted byte volume.",
        "instrument": "rrflow.context.bytes",
        "kind": "histogram",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.operation",
          "rrflow.outcome",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Authorized context input, output, selected, skipped, truncated, and compacted token volume.",
        "instrument": "rrflow.context.tokens",
        "kind": "histogram",
        "unit": "{token}"
      },
      {
        "attributes": [
          "rrflow.boundary",
          "rrflow.queue.kind"
        ],
        "description": "Unacknowledged bounded delivery items by stream class.",
        "instrument": "rrflow.delivery.backlog",
        "kind": "observable_gauge",
        "unit": "{item}"
      },
      {
        "attributes": [
          "rrflow.work.kind"
        ],
        "description": "Process RSS and allocator-owned bytes where the platform can identify them.",
        "instrument": "rrflow.process.memory",
        "kind": "observable_gauge",
        "unit": "By"
      },
      {
        "attributes": [
          "rrflow.work.kind"
        ],
        "description": "User and system CPU time for saturation and benchmark accounting.",
        "instrument": "rrflow.process.cpu.time",
        "kind": "counter",
        "unit": "s"
      },
      {
        "attributes": [
          "rrflow.outcome",
          "rrflow.work.kind",
          "rrflow.queue.kind",
          "error.type"
        ],
        "description": "Diagnostic points dropped by bounded queue, sampling, or encoding policy.",
        "instrument": "rrflow.telemetry.dropped",
        "kind": "counter",
        "unit": "{item}"
      },
      {
        "attributes": [
          "rrflow.outcome",
          "rrflow.work.kind",
          "error.type"
        ],
        "description": "Diagnostic encode, export, and exporter-rejection failures.",
        "instrument": "rrflow.telemetry.export.errors",
        "kind": "counter",
        "unit": "{item}"
      }
    ],
