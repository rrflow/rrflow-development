{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrflow.example/schemas/one-engine-handoff-v1.schema.json",
  "title": "Proposed RRFlow observable handoff envelope",
  "description": "Illustrative design only. Schema validation does not authenticate a plan, authorize effects, prove execution, or establish CI enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "state", "project_id", "task", "sender", "receiver", "plan", "source", "configuration_sha256", "authorization", "questions", "effects", "receipts"],
  "properties": {
    "version": {"const": 1},
    "profile": {"enum": ["repository_package", "engine_work"]},
    "state": {"enum": ["proposal", "accepted", "executing", "completed", "blocked", "superseded"]},
    "project_id": {"$ref": "#/$defs/id"},
    "task": {"$ref": "#/$defs/task"},
    "sender": {"$ref": "#/$defs/id"},
    "receiver": {"$ref": "#/$defs/id"},
    "plan": {"$ref": "#/$defs/plan"},
    "source": {"$ref": "#/$defs/source"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "repository": {"$ref": "#/$defs/repository"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "questions": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/question"}},
    "effects": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/effect"}},
    "receipts": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/receipt"}}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "repository_package"}}, "required": ["profile"]}, "then": {"required": ["repository"]}},
    {"if": {"properties": {"state": {"enum": ["accepted", "executing", "completed"]}}, "required": ["state"]}, "then": {"properties": {"authorization": {"properties": {"state": {"const": "authorized"}}, "required": ["grant_id", "approved_plan_sha256", "expires_at"]}}}},
    {"if": {"properties": {"state": {"const": "completed"}}, "required": ["state"]}, "then": {"properties": {"receipts": {"minItems": 1}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["id", "request_sha256", "goal"],
      "description": "Request content is retained only when separately authorized; a digest is not an authorization.",
      "properties": {"id": {"$ref": "#/$defs/id"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "goal": {"$ref": "#/$defs/text"}}
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "record_uri", "sha256", "predecessor_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "record_uri": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "git_revision", "inventory_sha256", "completeness", "inputs"],
      "properties": {
        "scope": {"$ref": "#/$defs/text"},
        "git_revision": {"oneOf": [{"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, {"type": "null"}]},
        "inventory_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "completeness": {"enum": ["complete", "partial", "unknown"]},
        "inputs": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/input"}}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["base_revision", "observed_head"],
      "description": "A candidate head belongs in a detached receipt, never inside that candidate's own commit.",
      "properties": {
        "base_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "observed_head": {"oneOf": [{"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, {"type": "null"}]}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["id", "resource", "content_sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "resource": {"$ref": "#/$defs/text"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "authorization": {
      "type": "object", "additionalProperties": false, "required": ["state", "principal", "policy_sha256"],
      "properties": {
        "state": {"enum": ["pending", "authorized", "denied"]}, "principal": {"$ref": "#/$defs/id"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}, "grant_id": {"$ref": "#/$defs/id"},
        "approved_plan_sha256": {"$ref": "#/$defs/sha256"}, "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "state", "prompt"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "state": {"enum": ["open", "answered"]}, "prompt": {"$ref": "#/$defs/text"}, "answer_ref": {"$ref": "#/$defs/text"}},
      "allOf": [{"if": {"properties": {"state": {"const": "answered"}}, "required": ["state"]}, "then": {"required": ["answer_ref"]}}]
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "intent", "capability", "scope", "resources", "source_dependencies", "question_dependencies", "budget", "expected_observation", "verification", "retry_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["repository_change", "engine_mutation", "project_mutation", "external_call", "memory_read", "memory_write"]},
        "intent": {"$ref": "#/$defs/text"}, "capability": {"$ref": "#/$defs/id"}, "scope": {"$ref": "#/$defs/text"},
        "resources": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/resource"}},
        "source_dependencies": {"$ref": "#/$defs/ids"}, "question_dependencies": {"$ref": "#/$defs/ids"},
        "budget": {"$ref": "#/$defs/budget"}, "expected_observation": {"$ref": "#/$defs/text"},
        "verification": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
        "retry_policy": {"enum": ["idempotent_with_receipt", "reconcile_before_retry", "no_retry"]}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_elapsed_ms", "max_memory_bytes", "max_input_bytes", "max_output_bytes", "max_attempts", "spend"],
      "properties": {"max_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "max_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "max_input_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "max_output_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "max_attempts": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "spend": {"$ref": "#/$defs/spend"}}
    },
    "spend": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["none", "bounded"]}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "max_micros": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}},
      "allOf": [{"if": {"properties": {"mode": {"const": "bounded"}}, "required": ["mode"]}, "then": {"required": ["currency", "max_micros"]}, "else": {"not": {"anyOf": [{"required": ["currency"]}, {"required": ["max_micros"]}]}}}]
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["kind", "selector", "locator"],
      "properties": {"kind": {"enum": ["repository_path", "project_path", "engine_record", "external_resource"]}, "selector": {"enum": ["exact", "prefix"]}, "locator": {"$ref": "#/$defs/text"}}
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "plan_sha256", "idempotency_key", "outcome", "observation_ref", "observed_resources", "evidence"],
      "properties": {"effect_id": {"$ref": "#/$defs/id"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "idempotency_key": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["accepted", "denied", "failed", "canceled", "uncertain"]}, "observation_ref": {"$ref": "#/$defs/text"}, "observed_resources": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/resource"}}, "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/evidence"}}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "locator", "sha256", "result"],
      "properties": {"kind": {"enum": ["diff", "test", "audit", "readback", "external_receipt"]}, "locator": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}, "result": {"enum": ["passed", "failed", "not_run", "uncertain"]}}
    }
  }
}
