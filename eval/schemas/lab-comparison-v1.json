{
  "$defs": {
    "AnswerResult": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "type": "string"
        },
        "disputed": {
          "description": "True when the score or its benchmark is publicly contested. The limits say how.",
          "type": "boolean"
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "description": "What a reader must know before using this number, including any dispute.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/ReferenceOrigin"
        },
        "reader_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "format": "double",
          "type": "number"
        },
        "score_name": {
          "type": "string"
        },
        "system": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "score",
        "score_name",
        "benchmark",
        "origin"
      ],
      "type": "object"
    },
    "ComparedSeek": {
      "properties": {
        "checked_on": {
          "type": "string"
        },
        "differs": {
          "description": "Each way this differs from the test, in words.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/SeekResult"
        },
        "same_conditions": {
          "description": "True only when nothing below differs.",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "source_title": {
          "type": "string"
        },
        "stale": {
          "description": "True when this source has not been reread lately.",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "source_title",
        "checked_on",
        "stale",
        "same_conditions",
        "differs",
        "result"
      ],
      "type": "object"
    },
    "HardwareClass": {
      "enum": [
        "single_core",
        "multi_core_server",
        "gpu",
        "managed_cloud",
        "not_stated"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "type": "string"
    },
    "ListedAnswer": {
      "properties": {
        "checked_on": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/AnswerResult"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "source_title": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "source_title",
        "checked_on",
        "stale",
        "result"
      ],
      "type": "object"
    },
    "MeasuredSpeed": {
      "description": "One system's speed at the recall target, from the report.",
      "properties": {
        "concurrency": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "filtered": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "latency_p99_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "queries_per_second": {
          "format": "double",
          "type": "number"
        },
        "system": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "system",
        "label",
        "filtered",
        "concurrency",
        "queries_per_second"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "Who stands behind a number, in the terms a reader needs to weigh it.",
      "enum": [
        "independent",
        "peer_reviewed",
        "vendor_own",
        "competitor",
        "authors"
      ],
      "type": "string"
    },
    "ReferenceOrigin": {
      "additionalProperties": false,
      "properties": {
        "measured_by": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "published": {
          "description": "`YYYY-MM-DD`. Absent when the source gives no day.",
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "description": "The exact words or data row this was read from.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "quote",
        "measured_by",
        "provenance"
      ],
      "type": "object"
    },
    "SeekResult": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "string"
        },
        "dimensions": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filtered": {
          "default": false,
          "type": "boolean"
        },
        "hardware": {
          "type": "string"
        },
        "hardware_class": {
          "$ref": "#/$defs/HardwareClass"
        },
        "k": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "latency_p99_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "limits": {
          "description": "What a reader must know before using this number.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/ReferenceOrigin"
        },
        "queries_per_second": {
          "format": "double",
          "type": "number"
        },
        "recall": {
          "format": "double",
          "type": "number"
        },
        "system": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "queries_per_second",
        "recall",
        "dataset",
        "hardware",
        "hardware_class",
        "origin"
      ],
      "type": "object"
    },
    "TestConditions": {
      "description": "What a published result must match to be set beside this test.",
      "properties": {
        "dataset": {
          "description": "The name others publish this data under. Generated data has none.",
          "type": [
            "string",
            "null"
          ]
        },
        "hardware_class": {
          "$ref": "#/$defs/HardwareClass"
        },
        "k": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "recall_target": {
          "format": "double",
          "type": "number"
        },
        "test": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "test",
        "title",
        "k",
        "recall_target",
        "hardware_class"
      ],
      "type": "object"
    },
    "WithoutSpeed": {
      "description": "A system with no speed to show, and why, so a gap cannot read as a result.",
      "properties": {
        "filtered": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "system",
        "label",
        "filtered",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "There is deliberately no winner and no rank here. It sets numbers side by side and says what\ndiffers, and a reader draws the conclusion.",
  "properties": {
    "answers_measured": {
      "type": "boolean"
    },
    "answers_note": {
      "type": "string"
    },
    "conditions": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestConditions"
        },
        {
          "type": "null"
        }
      ]
    },
    "measured": {
      "items": {
        "$ref": "#/$defs/MeasuredSpeed"
      },
      "type": "array"
    },
    "published_answers": {
      "items": {
        "$ref": "#/$defs/ListedAnswer"
      },
      "type": "array"
    },
    "published_seek": {
      "items": {
        "$ref": "#/$defs/ComparedSeek"
      },
      "type": "array"
    },
    "without_speed": {
      "items": {
        "$ref": "#/$defs/WithoutSpeed"
      },
      "type": "array"
    }
  },
  "required": [
    "measured",
    "without_speed",
    "published_seek",
    "answers_measured",
    "answers_note",
    "published_answers"
  ],
  "title": "Comparison",
  "type": "object"
}
