{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "type": "string"
    },
    "PlanScore": {
      "additionalProperties": false,
      "properties": {
        "file_precision": {
          "format": "double",
          "type": "number"
        },
        "file_recall": {
          "format": "double",
          "type": "number"
        },
        "files_expected": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_matched": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_named": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "matches_file_threshold": {
          "type": "boolean"
        },
        "records_cited": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records_expected": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files_named",
        "files_matched",
        "files_expected",
        "file_recall",
        "file_precision",
        "records_cited",
        "records_expected",
        "matches_file_threshold"
      ],
      "type": "object"
    },
    "RetrievalCapture": {
      "additionalProperties": false,
      "description": "What an MCP tool gave the agent and what the agent did with it, separately, because a\ncorrect result that goes unused is a different failure from a search that missed.",
      "properties": {
        "bytes_returned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "calls": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_returned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "needed_files_returned": {
          "description": "Files the change needed that the tool returned.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "needed_files_used": {
          "description": "Of those, the ones the plan named.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "bytes_returned",
        "files_returned",
        "needed_files_returned",
        "needed_files_used"
      ],
      "type": "object"
    },
    "TaskRunOutcome": {
      "oneOf": [
        {
          "const": "planned",
          "description": "It replied with a plan, which was graded.",
          "type": "string"
        },
        {
          "const": "no_plan",
          "description": "It replied without a readable plan, which does not match the file threshold.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "It hit its time limit, so the comparison is incomplete.",
          "type": "string"
        },
        {
          "const": "provider_failed",
          "description": "The provider failed, so the comparison is incomplete and stays visible.",
          "type": "string"
        },
        {
          "const": "tooling_failed",
          "description": "The arm's own tools did not come up, so this measured nothing about the arm.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm": {
      "$ref": "#/$defs/Id"
    },
    "cache_read_tokens": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "cache_write_tokens": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "cost_usd": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "input_tokens": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "manifest_sha256": {
      "$ref": "#/$defs/Digest"
    },
    "model": {
      "$ref": "#/$defs/Id"
    },
    "model_reported": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "$ref": "#/$defs/TaskRunOutcome"
    },
    "output_tokens": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "provider_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "repetition": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "reply_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "description": "The provider's whole output, kept beside the run under this digest."
    },
    "retrieval": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalCapture"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "score": {
      "$ref": "#/$defs/PlanScore"
    },
    "seconds": {
      "format": "double",
      "type": "number"
    },
    "task": {
      "$ref": "#/$defs/Id"
    },
    "tool_calls": {
      "additionalProperties": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "turns": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "task",
    "arm",
    "model",
    "repetition",
    "outcome",
    "score",
    "seconds"
  ],
  "title": "TaskRun",
  "type": "object"
}
