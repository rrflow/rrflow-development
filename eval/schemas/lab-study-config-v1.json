{
  "$defs": {
    "AnalysisChoices": {
      "additionalProperties": false,
      "description": "Thresholds a study may set for itself. Anything left out keeps the catalog's value.",
      "properties": {
        "alpha": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_floor_solve_rate": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min_file_precision": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min_file_recall": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "order_seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest",
          "description": "The catalog this study was configured against. A changed catalog means choosing again."
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "type": "string"
    },
    "SpendLimits": {
      "additionalProperties": false,
      "description": "A run cannot start without these, and the person who pays decides them.",
      "properties": {
        "max_seconds_per_run": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_usd_per_run": {
          "format": "double",
          "type": "number"
        },
        "max_usd_total": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "max_seconds_per_run",
        "max_usd_per_run",
        "max_usd_total"
      ],
      "type": "object"
    },
    "StudyStage": {
      "description": "A pilot tests the test, so its report cannot answer the question. A confirmatory study can.",
      "enum": [
        "pilot",
        "confirmatory"
      ],
      "type": "string"
    },
    "TaskModel": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/TaskProviderKind"
        }
      },
      "required": [
        "id",
        "provider",
        "model"
      ],
      "type": "object"
    },
    "TaskProviderKind": {
      "enum": [
        "claude_code"
      ],
      "type": "string"
    },
    "TaskSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "select": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "select"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "seed": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "select": {
              "const": "seeded",
              "type": "string"
            }
          },
          "required": [
            "select",
            "count",
            "seed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ids": {
              "items": {
                "$ref": "#/$defs/Id"
              },
              "type": "array"
            },
            "select": {
              "const": "listed",
              "type": "string"
            }
          },
          "required": [
            "select",
            "ids"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a person or a screen edits. It names a credential and never holds one.",
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalysisChoices",
      "default": {}
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/Id"
      },
      "type": "array"
    },
    "baseline_arm": {
      "$ref": "#/$defs/Id"
    },
    "capture_proof_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "description": "The audit proving capture on a real run, which a confirmatory study must have."
    },
    "catalog": {
      "$ref": "#/$defs/CatalogReference"
    },
    "credential_env": {
      "description": "The environment variable holding the provider's key.",
      "type": [
        "string",
        "null"
      ]
    },
    "floor_arm": {
      "$ref": "#/$defs/Id"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/TaskModel"
      },
      "type": "array"
    },
    "repetitions": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "spend": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpendLimits"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "$ref": "#/$defs/StudyStage"
    },
    "tasks": {
      "$ref": "#/$defs/TaskSelection"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "stage",
    "catalog",
    "tasks",
    "arms",
    "baseline_arm",
    "floor_arm",
    "models",
    "repetitions"
  ],
  "title": "StudyConfig",
  "type": "object"
}
