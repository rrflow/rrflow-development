{
  "schema_version": 1,
  "binding": {
    "id": "rrflow-exact",
    "label": "RRFlow, exact scan",
    "kind": "rrflow",
    "location": "loopback",
    "endpoint": "http://127.0.0.1:19477",
    "artifact": "source-built rrflow, see the run's journal",
    "storage_profile": "rrflowKV on local disk",
    "availability": {
      "state": "available"
    },
    "index": {
      "index": "exact"
    },
    "search_ladder": [
      {
        "id": "exact"
      }
    ],
    "credentials": {
      "principal_env": "RRFLOW_LAB_PRINCIPAL",
      "secret_env": "RRFLOW_LAB_SECRET",
      "instance_env": "RRFLOW_LAB_INSTANCE"
    },
    "memory_probe": [
      "eval/lab/probe.sh",
      "memory",
      "rrflow"
    ],
    "disk_probe": [
      "eval/lab/probe.sh",
      "disk",
      "rrflow"
    ]
  },
  "launch": {
    "kind": "rrflow_engine",
    "port": 19477
  }
}
