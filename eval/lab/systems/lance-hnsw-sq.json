{
  "schema_version": 1,
  "binding": {
    "id": "lance-hnsw-sq",
    "label": "Lance, HNSW with scalar quantization",
    "kind": "custom",
    "location": "loopback",
    "endpoint": "http://127.0.0.1:18090",
    "artifact": "lancedb 0.41.0 and pylance 14.0.2, locked in eval/lab/lance-requirements.txt, behind eval/lab/lance_system.py",
    "storage_profile": "Lance files on local disk",
    "availability": {
      "state": "available"
    },
    "index": {
      "index": "hnsw",
      "m": 16,
      "ef_construction": 100
    },
    "search_ladder": [
      {
        "id": "ef-16",
        "ef": 16,
        "exact_rerank": 16
      },
      {
        "id": "ef-32",
        "ef": 32,
        "exact_rerank": 32
      },
      {
        "id": "ef-64",
        "ef": 64,
        "exact_rerank": 64
      },
      {
        "id": "ef-128",
        "ef": 128,
        "exact_rerank": 128
      },
      {
        "id": "ef-256",
        "ef": 256,
        "exact_rerank": 256
      }
    ],
    "memory_probe": [
      "eval/lab/probe.sh",
      "memory",
      "shim"
    ],
    "disk_probe": [
      "eval/lab/probe.sh",
      "disk",
      "shim"
    ],
    "limits": [
      "Lance is embedded and has no server, so it runs behind a Python HTTP shim. JSON handling and Python's lock count against it, which most affects the 8-client cases."
    ]
  },
  "launch": {
    "kind": "process",
    "command": [
      "{env:RRFLOW_LAB_LANCE_PYTHON}",
      "{lab}/lance_system.py",
      "18090",
      "{data}"
    ],
    "port": 18090,
    "pid_file": "shim.pid",
    "embedded_under_vectordbbench": true,
    "ready": {
      "url": "http://127.0.0.1:18090/health",
      "seconds": 60
    }
  },
  "vectordbbench": [
    "lancedbivfhnswsq",
    "--uri",
    "{data}/vdbbench",
    "--num-partitions",
    "1",
    "--m",
    "16",
    "--ef-construction",
    "100",
    "--ef",
    "{ef}"
  ]
}
