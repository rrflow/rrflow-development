{
  "schema_version": 1,
  "binding": {
    "id": "rrflow-hnsw",
    "label": "RRFlow, HNSW with exact rerank",
    "kind": "rrflow",
    "location": "loopback",
    "endpoint": "http://127.0.0.1:19477",
    "artifact": "source-built rrflow, see the run's journal",
    "storage_profile": "rrflowKV on local disk",
    "availability": {
      "state": "available"
    },
    "index": {
      "index": "hnsw",
      "m": 16,
      "ef_construction": 100
    },
    "search_ladder": [
      {
        "id": "ef-16",
        "ef": 16,
        "exact_rerank": 16
      },
      {
        "id": "ef-32",
        "ef": 32,
        "exact_rerank": 32
      },
      {
        "id": "ef-64",
        "ef": 64,
        "exact_rerank": 64
      },
      {
        "id": "ef-128",
        "ef": 128,
        "exact_rerank": 128
      },
      {
        "id": "ef-256",
        "ef": 256,
        "exact_rerank": 256
      }
    ],
    "credentials": {
      "principal_env": "RRFLOW_LAB_PRINCIPAL",
      "secret_env": "RRFLOW_LAB_SECRET",
      "instance_env": "RRFLOW_LAB_INSTANCE"
    },
    "memory_probe": [
      "eval/lab/probe.sh",
      "memory",
      "rrflow"
    ],
    "disk_probe": [
      "eval/lab/probe.sh",
      "disk",
      "rrflow"
    ],
    "limits": [
      "Its collection uses the pinned memory tier, because the cached tier decodes this JSON artifact on every query above 64 MiB.",
      "Its artifact is refused above the pinned tier's 256 MiB, about 65,000 points at 384 dimensions by one measured artifact's size, so larger tests fail until the artifact is compact.",
      "A graph is built inside one request, on the first request after ingest."
    ]
  },
  "launch": {
    "kind": "rrflow_engine",
    "port": 19477
  }
}
